<!--
Environment shell for the table tennis scene: floor, skybox, lights.
Everything with physical parameters (arm, paddle, ball, table) is added by
tt/model.py from config/default.yaml, so no physical value lives here.
-->
<mujoco model="tt_scene">
  <statistic center="0.4 0 1.0" extent="2.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-15" offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_top" rgba="0.05 0.25 0.45 1"/>
    <material name="table_line" rgba="1 1 1 1"/>
    <material name="net" rgba="0.9 0.9 0.9 0.6"/>
    <material name="stand" rgba="0.25 0.25 0.25 1"/>
    <material name="blade_red" rgba="0.8 0.1 0.1 1"/>
    <material name="handle_wood" rgba="0.6 0.45 0.25 1"/>
    <material name="ball_orange" rgba="1.0 0.55 0.1 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <light pos="1.5 -1.5 2.5" dir="-0.5 0.5 -1" diffuse="0.3 0.3 0.3"/>
    <!-- contype=1 collides with the arm/table; conaffinity=3 also accepts the ball (contype=2),
         so a dropped ball comes to rest on the floor instead of falling forever. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="3"/>
  </worldbody>
</mujoco>
